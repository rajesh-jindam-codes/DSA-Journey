import heapq
def findAllPaths(n,edges,distanceThreshold):
    adjList=[[] for _ in range(n)]
    for u,v,w in edges:
        adjList[u].append([v,w])
        adjList[v].append([u,w])
    def dijkstras(src):
        distance=[float('inf')]*n
        distance[src]=0
        pq=[(0,src)]
        while pq:
            node,dist=heapq.heappop(pq)
            for adjNode,w in adjList[node]:
                newDist=dist+w
                if newDist<distance[adjNode]:
                    distance[adjNode]=newDist
                    heapq.heappush(pq,(adjNode,newDist))
        return distance
    minNeigh=n
    city=-1
    for i in range(n):
        row=dijkstras(i)
        count=sum(dist<=distanceThreshold for dist in row)
        if count<=minNeigh:
            minNeigh=count
            city=i
    return city
n=4
edges=[[0,1,3],[1,2,1],[1,3,4],[2,3,1]]
distanceThreshold=4
print(findAllPaths(n,edges,distanceThreshold))
