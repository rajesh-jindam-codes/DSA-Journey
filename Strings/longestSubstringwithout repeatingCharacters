def longestSubstring(s):
    if len(s)==0:
        return 0
    maxLen=0
    for i in range(len(s)):
        set={}
        for j in range(i,len(s)):
            if s[j] in set:
                break
            maxLen=max(maxLen,j-i+1)
            set[s[j]]=1
    return maxLen
print(longestSubstring('ABVUCDSHGADHFC'))